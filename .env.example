AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=


AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_MODEL=gpt-5.1
AZURE_OPENAI_API_VERSION=2025-04-01-preview


AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small-backup
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=

AZURE_OPENAI_EMBEDDING_OTHER_DEPLOYMENT=text-embedding-3-small

# ---------- Database (SQLite) ----------
# DB file lives on the host at ./db/rag.db, bind-mounted into the container
# at /srv/db. Entrypoint runs `alembic upgrade head` on boot.
DATABASE_URL=sqlite+aiosqlite:////srv/db/rag.db

# ---------- Local file storage ----------
# Inside the container the compose bind mount puts ./storage at /srv/storage.
STORAGE_DIR=/srv/storage
MAX_UPLOAD_MB=100



# ---------- Pipeline tuning ----------
EMBED_BATCH_SIZE=64
CHUNK_TOKENS=800
CHUNK_OVERLAP=100
SEARCH_TOP_K_CHUNKS=30
SEARCH_TOP_K_DOCS=5
CHAT_MAX_CONTEXT_CHUNKS=12
INGEST_CONCURRENCY=10


EMBED_MAX_INFLIGHT_BATCHES=8
SEARCH_MAX_INFLIGHT_UPLOADS=10

# ---------- Feature flags ----------
# Semantic reranking requires Azure AI Search Standard S1+. Set false on
# Free/Basic or the index creation call will fail.
ENABLE_SEMANTIC_RANKING=true
# Create-or-update the index on every startup. Set false if you manage the
# schema manually (e.g. created it from index.json via REST PUT).
ENSURE_INDEX_ON_STARTUP=true


# ---------- OCR ----------
OCR_ENABLED=true
OCR_DPI=120
# OCR_WORKERS = OCR process pool size. Default is 6; raise on bigger hosts
# (rule of thumb: vCPU - 2 to leave headroom for FastAPI / asyncio / chunker).
OCR_WORKERS=6
# Pages with strictly fewer than OCR_MIN_CHARS_FOR_TEXT characters in the
# text layer are eligible for OCR.
OCR_MIN_CHARS_FOR_TEXT=50
# A page is treated as scanned only if its largest single image covers at
# least this fraction of the page area.
OCR_MIN_IMAGE_AREA_RATIO=0.9
OCR_LANGUAGES=eng


AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
