AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=


AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=


AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=

AZURE_OPENAI_EMBEDDING_OTHER_DEPLOYMENT=

# ---------- Database (SQLite) ----------
# DB file lives on the host at ./db/rag.db, bind-mounted into the container
# at /srv/db. Entrypoint runs `alembic upgrade head` on boot.
DATABASE_URL=

# ---------- Local file storage ----------
# Inside the container the compose bind mount puts ./storage at /srv/storage.
STORAGE_DIR=
MAX_UPLOAD_MB=



# ---------- Pipeline tuning ----------
EMBED_BATCH_SIZE=
CHUNK_TOKENS=
CHUNK_OVERLAP=
SEARCH_TOP_K_CHUNKS=
SEARCH_TOP_K_DOCS=
CHAT_MAX_CONTEXT_CHUNKS=
INGEST_CONCURRENCY=


EMBED_MAX_INFLIGHT_BATCHES=
SEARCH_MAX_INFLIGHT_UPLOADS=

# ---------- Feature flags ----------
# Semantic reranking requires Azure AI Search Standard S1+. Set false on
# Free/Basic or the index creation call will fail.
ENABLE_SEMANTIC_RANKING=
# Create-or-update the index on every startup. Set false if you manage the
# schema manually (e.g. created it from index.json via REST PUT).
ENSURE_INDEX_ON_STARTUP=



AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
