AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=


AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=


AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=

# ---------- Database (SQLite) ----------
# DB file lives on the host at ./db/rag.db, bind-mounted into the container
# at /srv/db. Entrypoint runs `alembic upgrade head` on boot.
DATABASE_URL=

# ---------- Local file storage ----------
# Inside the container the compose bind mount puts ./storage at /srv/storage.
STORAGE_DIR=
MAX_UPLOAD_MB=



# ---------- Pipeline tuning ----------
EMBED_BATCH_SIZE=
CHUNK_TOKENS=
CHUNK_OVERLAP=
SEARCH_TOP_K_CHUNKS=
SEARCH_TOP_K_DOCS=
CHAT_MAX_CONTEXT_CHUNKS=
INGEST_CONCURRENCY=

# ---------- Agentic search (POST /query) ----------
# An LLM planner splits multi-part questions into up to
# AGENTIC_MAX_SUBQUERIES parallel searches; a judge may then request
# follow-ups up to a hard cap of AGENTIC_MAX_SEARCHES index searches per
# request. Single-intent questions still run exactly one hybrid search.
# Set AGENTIC_SEARCH_ENABLED=false to restore the classic single-search path.
AGENTIC_SEARCH_ENABLED=
AGENTIC_MAX_SUBQUERIES= ##optional (default 3)
AGENTIC_MAX_SEARCHES= ##optional (default 5)
AGENTIC_SUBQUERY_TOP_K= ##optional (default 15; 0 = SEARCH_TOP_K_CHUNKS)
AGENTIC_LLM_TIMEOUT_S= ##optional (default 20)


EMBED_MAX_INFLIGHT_BATCHES=
SEARCH_MAX_INFLIGHT_UPLOADS=

# ---------- OCR (scanned PDF pages, Tesseract) ----------
# OCR_WORKERS = process pool size. Leave at least 2 cores free for the rest
# of the pipeline (chunker, FastAPI, asyncio). On an 8-core host, 6 is the
# sweet spot. Set OCR_ENABLED=false to disable entirely (scanned pages then
# fall through as today, i.e. fail with "empty extraction").
OCR_ENABLED=
OCR_DPI=

OCR_WORKERS= ## optional
OCR_MIN_CHARS_FOR_TEXT= ##optional
OCR_MIN_IMAGE_AREA_RATIO= ##optional
OCR_LANGUAGES= #optional

# Classifier-only mode. When true, the same scan-detection runs but ANY
# scanned page rejects the whole doc instead of OCR-ing it. Use it for a
# fast first-pass index of text-only docs when there isn't time to OCR
# everything. Typical fast-index combo:
#   OCR_ENABLED=false
#   OCR_REJECT_SCANNED=true
OCR_REJECT_SCANNED= ##optional

# ---------- Feature flags ----------
# Semantic reranking requires Azure AI Search Standard S1+. Set false on
# Free/Basic or the index creation call will fail.
ENABLE_SEMANTIC_RANKING=
# Create-or-update the index on every startup. Set false if you manage the
# schema manually (e.g. created it from index.json via REST PUT).
ENSURE_INDEX_ON_STARTUP=



AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
